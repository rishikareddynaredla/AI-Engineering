#dictionary
student={
    "name": "Rahul",
    "age": 20,
    "branch": "CSE",
    "cgpa":9.9
}
print(student["name"]," ",str(student["age"])," ")
student["college"]="CMR"
student["cgpa"]=9.69
student.pop("age")
for i,j in student.items():
    print(i," ",j)

#nested dictionary

student = {
    "name": "Rahul",
    "marks": {
        "python": 85,
        "dsa": 78,
        "math": 91
    }
}

print("Name:",student["name"])
for i,j in student["marks"].items():
    print(i,":",j)

