#list basics
nums=[10,20,30,40,50]
print(nums[0]," ",nums[-1]," ",sum(nums)," ",len(nums)," ",max(nums)," ",min(nums)," ",list(reversed(nums)))

#student names
students=["Rahul","Aman","Priya","Arjun"]
students.append("Sneha")
students.remove("Aman")
students[2] = "Kavya"
if("Arjun" in students):
    print("Arjun is there")
else:
    print("Arjun isn't there")
for i,student in enumerate(students):
    print(i," ",student)

#marks analyser
marks=[85,72,91,64,88,45,93]
print(sum(marks)," ",sum(marks)/len(marks)," ",max(marks)," ",min(marks)," ",len(marks)," ")
for i in marks:
    if i>40:
        print(i," is a pass")

for i in marks:
    if(i>=90):
        print(i," is an A grade")

